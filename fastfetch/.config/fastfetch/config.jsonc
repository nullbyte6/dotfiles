{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "constants": ["─────────────────"]
  },
  "modules": [
    {
      "type": "title",
      "keyWidth": 8
    },
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "90"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󰔛 Uptime",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "90"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "green"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
