# Theme
theme = Catppuccin Macchiato

# Keybinds
#keybind = global:super+space=toggle_quick_terminal
keybind = ctrl+K=toggle_command_palette
keybind = ctrl+F=start_search
keybind = ctrl+R=reload_config
keybind = ctrl+shift+up=new_split:up
keybind = ctrl+shift+down=new_split:down
keybind = ctrl+shift+left=new_split:left
keybind = ctrl+shift+right=new_split:right

keybind = ctrl+shift+alt+up=goto_split:up
keybind = ctrl+shift+alt+down=goto_split:down
keybind = ctrl+shift+alt+left=goto_split:left
keybind = ctrl+shift+alt+right=goto_split:right

# Window
window-vsync = true
window-theme = ghostty
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# Window - GTK
gtk-titlebar-style = tabs
