#
# ~/.zsrc
#

# Default prompt (user@host dir>>) with the git branch added after the
# directory and a green tick or red cross for the last command's status.
# The branch is only shown inside a git repository.

zsprompt '\e[1;32m\u@\h\e[0m \e[1;34m\W\e[0m$(test -n "\g" && printf " \e[1;35m(%s)\e[0m" "\g") $(test \? -eq 0 && printf "\e[1;32m✓ \e[0m" || printf "\e[1;31m✗ \e[0m")\e[1;33m>>\e[0m '
HISTAPPEND=never

export JAVA_HOME="/opt/jdk-25"
export PATH=$PATH:$JAVA_HOME/bin
export EDITOR="nvim"

# Functions copied from ~/.bashrc_functions
source "$HOME/dotfiles/zsrc/.zsrc_functions"
clear
pokemon-colorscripts --random --no-title
