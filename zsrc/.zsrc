#
# ~/.zsrc
#

# Default prompt (user@host dir>>) with the git branch added after the
# directory. The branch is only shown inside a git repository.
zsprompt '\e[1;32m\u@\h\e[0m \e[1;34m\W\e[0m$(test -n "\g" && printf " \e[1;35m(%s)\e[0m" "\g")\e[1;33m>>\e[0m '

# Functions copied from ~/.bashrc_functions
source "$HOME/dotfiles/zsrc/.zsrc_functions"
